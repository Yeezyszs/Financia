# --- Supabase ---
SUPABASE_URL=
# Service role: IGNORA RLS. Somente jobs (cron/webhook). Nunca no front.
SUPABASE_SERVICE_ROLE_KEY=
# Anon: respeita RLS e vai para o browser. Publica por design.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Google OAuth2 (Gmail API) ---
# Criar em: Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/callback
# Obtido no primeiro consentimento. Escopo: gmail.readonly
GOOGLE_REFRESH_TOKEN=

# --- Gmail Push (Pub/Sub) ---
GOOGLE_PUBSUB_TOPIC=
# Segredo compartilhado para validar o POST que chega do Pub/Sub
PUBSUB_VERIFICATION_TOKEN=

# --- Cron / jobs ---
# Protege /api/sync. A Vercel manda este valor no header Authorization.
CRON_SECRET=

# Dono das transacoes ingeridas pelo job (uuid do auth.users)
DEFAULT_OWNER_ID=
